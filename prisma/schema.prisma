generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Divisi {
  id          Int      @id @default(autoincrement())
  name        String
  code        String   @unique
  description String?
  liftPlans   LiftPlan[]
  users       User[]
  createdAt   DateTime @default(now())
}

model LoadType {
  id             Int      @id @default(autoincrement())
  name           String
  category       String
  defaultWeight  Float?   // kg
  liftPlans      LiftPlan[]
  createdAt      DateTime @default(now())
}

model Crane {
  id              Int      @id @default(autoincrement())
  model           String   @unique
  craneClass      String   // "50 ton", "100 ton", etc
  maxCapacity     Float    // kg
  maxBoomLength   Float    // meters
  maxRadius       Float    // meters
  outriggerLoad   Float?   // kg
  loadChart       String   // JSON string of load chart data
  liftPlans       LiftPlan[]
  createdAt       DateTime @default(now())
}

model LiftPlan {
  id                    Int      @id @default(autoincrement())
  planNumber            String   @unique
  divisiId              Int
  divisi                Divisi   @relation(fields: [divisiId], references: [id])
  title                 String
  description           String?
  liftType              String   @default("routine") // routine | critical
  scheduledDate         DateTime?
  location              String?
  status                String   @default("draft") // draft | submitted | approved | rejected | completed

  // Load Data
  loadTypeId            Int?
  loadType              LoadType? @relation(fields: [loadTypeId], references: [id])
  loadDescription       String?
  loadWeight            Float?   // kg
  loadLength            Float?   // m
  loadWidth             Float?   // m
  loadHeight            Float?   // m
  cogX                  Float?
  cogY                  Float?
  cogZ                  Float?
  totalLoad             Float?   // kg (auto-calc)

  // Crane Data
  craneId               Int?
  crane                 Crane?   @relation(fields: [craneId], references: [id])
  liftRadius            Float?   // m
  boomLength            Float?   // m
  boomAngle             Float?   // deg
  craneCapacityAtRadius Float?   // kg
  utilizationPct        Float?   // % (auto-calc)

  // Rigging Data
  slingLegs             Int?
  slingAngle            Float?   // deg
  slingTension          Float?   // kg (auto-calc)
  slingWllRequired      Float?   // kg (auto-calc)
  slingSizeSelected     String?
  shackleSizeSelected   String?

  // Site Data
  groundType            String?
  groundBearingCapacity Float?   // kPa
  slope                 Float?   // deg
  windSpeed             Float?   // km/h
  overheadClearance     Float?   // m
  nearestObstacle       Float?   // m

  // Risk Data
  riskScore             Float?   // 0-100 (auto-calc)
  riskLevel             String?  // low | medium | high
  hazardsIdentified     String?  // JSON
  mitigations           String?  // JSON

  // Metadata
  createdBy             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  approvals             LiftApproval[]
}

model LiftApproval {
  id          Int      @id @default(autoincrement())
  liftPlanId  Int
  liftPlan    LiftPlan @relation(fields: [liftPlanId], references: [id], onDelete: Cascade)
  approverRole String
  approverName String
  status      String   @default("pending") // pending | approved | rejected
  comment     String?
  approvedAt  DateTime?
  orderSequence Int
  createdAt   DateTime @default(now())
}

model HazardTemplate {
  id                Int      @id @default(autoincrement())
  name              String
  category          String
  description       String?
  defaultMitigation String?
  riskWeight        Float    @default(1.0)
  createdAt         DateTime @default(now())
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  role      String   // rigger | supervisor | safety_officer | manager
  divisiId  Int?
  divisi    Divisi?  @relation(fields: [divisiId], references: [id])
  email     String?
  createdAt DateTime @default(now())
}
